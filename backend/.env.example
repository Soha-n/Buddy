# Ollama REST endpoint. Use the literal IPv4 address to avoid slow
# localhost -> ::1 resolution on Windows.
OLLAMA_HOST=http://127.0.0.1:11434

# Port this backend listens on.
PORT=8000

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420

LOG_LEVEL=info

# Optional: override where Ollama stores models. Free disk space is measured
# here, since that is the volume a download actually lands on.
# OLLAMA_MODELS=D:\ollama\models

# Optional: a self-hosted SearXNG instance for private web search. Probed once
# at first search; if it answers JSON here it is used instead of DuckDuckGo.
# Buddy does not install or start it.
# SEARXNG_URL=http://127.0.0.1:8888

# --------------------------------------------------------------------------- #
# Web search. Works out of the box: Buddy installs and runs its own SearXNG on
# first launch, then uses it for every search. Nothing to sign up for.
# --------------------------------------------------------------------------- #

# Set false to use an instance you run yourself (see SEARXNG_URL) instead of the
# managed one.
# SEARXNG_MANAGED=true
# SEARXNG_PORT=8888
# Where the managed install lives. Default: backend/data/searxng
# SEARXNG_INSTALL_DIR=
# Only used when SEARXNG_MANAGED=false
# SEARXNG_URL=http://127.0.0.1:8888

# Optional: your own API key, used if the built-in instance is unavailable.
# Provider: brave|tavily
# SEARCH_PROVIDER=
# SEARCH_API_KEY=

# Last-resort fallback, used only while the built-in instance is installing or if
# it fails. It is what guarantees search is never simply unavailable. Note that
# scraping these front ends is against their terms of service; set false if you
# would rather search fail than scrape.
# ALLOW_SCRAPING_FALLBACK=true

# --------------------------------------------------------------------------- #
# Weather. On by default via wttr.in: Apache-2.0, no API key, no non-commercial
# clause, and self-hostable - so "current temp" works out of the box in a
# commercial build with nothing to sign up for.
# --------------------------------------------------------------------------- #

# wttr.in (default) | "" (answer weather from web search instead)
# WEATHER_PROVIDER=wttr.in

# Point this at your own wttr.in instance to remove the last third party from
# weather answers entirely. See https://github.com/chubin/wttr.in
# WEATHER_BASE_URL=https://wttr.in

# Reserved for a future key-based provider; wttr.in needs no key.
# WEATHER_API_KEY=
