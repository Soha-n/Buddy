{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buddy",
  "version": "1.0.0",
  "identifier": "com.buddy.desktop",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "Buddy",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Buddy",
    "copyright": "Buddy",
    "shortDescription": "Local AI chat",
    "longDescription": "Buddy runs AI models locally on your own machine.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
